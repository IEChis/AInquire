{
  "name": "ai-ask-book",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI问书 — 基于书籍内容的 AI 阅读助手 Demo (Mock RAG)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "eval": "esbuild eval/run.ts --bundle --platform=node --format=esm --outfile=eval/_run.mjs --log-level=error && node eval/_run.mjs",
    "eval:diag": "esbuild eval/diagnose.ts --bundle --platform=node --format=esm --outfile=eval/_diag.mjs --log-level=error && node eval/_diag.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
