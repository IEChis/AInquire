# AI问书 · LLM 接入配置模板
# --------------------------------------------------------------------------
# 1. 复制本文件为 `.env`
# 2. 填入你的真实 API_BASE / API_KEY / MODEL
# 3. 重启 `npm run dev`
# --------------------------------------------------------------------------

# 大模型 API 接入地址（OpenAI Chat Completions 协议）
VITE_LLM_API_BASE=https://your-llm-provider.example/v1

# 你的 API Key（不要提交到 Git，已在 .gitignore 中忽略 .env）
VITE_LLM_API_KEY=

# 模型名（如 gpt-4o-mini / deepseek-chat / qwen-turbo 等）
VITE_LLM_MODEL=

# 是否启用真实 LLM：true=优先用 LLM（失败回退 Mock），false=纯 Mock 演示
VITE_LLM_ENABLED=true
